#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0
#define GAME 1
#define WASD 2
#define LWR 3
#define RSE 4
#define ADJ 5
#define OPT 6

&lt { quick_tap_ms = <200>; };
&mt { quick_tap_ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Momentary layer that also holds F19 / F18 while the key is down,
        // so the web viewer (viewer/index.html) can see which thumb layer key is held.
        // Not F20: on Linux xkb maps it to XF86AudioMicMute, which the desktop grabs.
        mo_f19: mo_f19 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_press &kp F19>
                , <&macro_pause_for_release>
                , <&macro_release &kp F19>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };
        mo_f18: mo_f18 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_press &kp F18>
                , <&macro_pause_for_release>
                , <&macro_release &kp F18>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };

        // Thumb Opt: holds LALT and, while held, the OPT layer (there V toggles WASD)
        mo_alt: mo_alt {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_press &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };

        // Same as &lt (tap-preferred, 200 ms), but the hold side is &mo_f18
        lt_f18: layer_tap_f18 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo_f18>, <&kp>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_F2 {
            timeout-ms = <50>;
            layers = <DEF GAME LWR RSE ADJ>;
            key-positions = <0 1>;
            bindings = <&kp F2>;
        };
        combo_ENTER {
            timeout-ms = <50>;
            layers = <DEF GAME LWR RSE ADJ>;
            key-positions = <3 4>;
            bindings = <&kp ENTER>;
        };
         combo_BS {
            timeout-ms = <50>;
            layers = <DEF GAME LWR RSE ADJ>;
            key-positions = <4 5>;
            bindings = <&kp BSPC>;
        };
        combo_Del {
            timeout-ms = <50>;
            layers = <DEF GAME LWR RSE ADJ>;
            key-positions = <28 29>;
            bindings = <&kp DEL>;
        };
        // Ctrl + Z + X + C → Cmd+Shift+4 (macOS area screenshot)
        combo_SCREENSHOT {
            timeout-ms = <80>;
            layers = <DEF GAME LWR RSE ADJ>;
            key-positions = <24 25 26 27>;
            bindings = <&kp LG(LS(N4))>;
        };
    };
};


/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// .-------------------------------------------------------.       .-----------------------------------------------------------.
// |  ESC  |    Q    |    W   |   E    |    R    |    T    |       |   Y   |    U    |    I    |    O    |     P    |     [    |
// |-------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
// |  SHFT |    A    |    S   |   D    |    F    |    G    |       |   H   |    J    |    K    |    L    |     ;    |     '    |
// |-------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
// |  CTRL |    Z    |    X   |   C    |    V    |    B    |       |   N   |    M    |    ,    |    .    |     /    |     ]    |
// '--------------------------+--------+---------+---------+       |-------+---------+---------+-------------------------------'
//                            |  ALT   |   LWR   | RSE/SPC |       |  RET  |   BKSP  |   GUI   |
//                            '--------+---------+---------'       '-------+---------+---------'
                        bindings = <
     &kp ESC    &kp Q       &kp W       &kp E        &kp R        &kp T          &kp Y      &kp U        &kp I        &kp O       &kp P          &kp LBKT
     &kp LSHFT  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G          &kp H      &hm LSHFT J  &hm LCTRL K  &hm LALT L  &hm LGUI SEMI  &kp SQT
     &kp LCTRL  &kp Z       &kp X       &kp C        &kp V        &kp B          &kp N      &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RBKT
                            &mo_alt OPT &mo_f19 LWR  &lt_f18 RSE SPACE               &kp ENTER  &kp BSPC     &kp LWIN
                        >;
                };


                game_layer {
// .-------------------------------------------------------.       .-----------------------------------------------------------.
// |  ESC  |    T    |    Q   |   W    |    E    |    R    |       |   Y   |    U    |    I    |    O    |     P    |     [    |
// |-------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
// |   G   |   SHFT  |    A   |   S    |    D    |    F    |       |   H   |    J    |    K    |    L    |     ;    |     '    |
// |-------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
// |   Z   |   CTRL  |    H   |   C    |    V    |    B    |       |   N   |    M    |    ,    |    .    |     /    |     ]    |
// '--------------------------+--------+---------+---------+       |-------+---------+---------+-------------------------------'
//                            |  ALT   |   LWR   |   SPC   |       |  RET  |   BKSP  |   GUI   |
//                            '--------+---------+---------'       '-------+---------+---------'
                        bindings = <
     &kp ESC  &kp T      &kp Q     &kp W    &kp E   &kp R          &kp Y      &kp U     &kp I      &kp O    &kp P     &kp LBKT
     &kp G    &kp LSHFT  &kp A     &kp S    &kp D   &kp F          &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
     &kp Z    &kp LCTRL  &kp H     &kp C    &kp V   &kp B          &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RBKT
                         &mo_alt OPT  &mo_f19 LWR  &kp SPACE              &kp ENTER  &kp BSPC  &kp LWIN
                        >;
                };


                wasd_layer {
// Opt+V toggles this layer: left-hand-only games.
// .-------------------------------------------------------.
// |       |         |   UP   |        |         |    M    |
// |-------+---------+--------+--------+---------+---------|
// |       |  LEFT   |  DOWN  | RIGHT  |         |  SPACE  |
// |-------+---------+--------+--------+---------+---------|
// |       |         |        |        |         |         |
// '--------------------------+--------+---------+---------+
                        bindings = <
     &trans  &trans     &kp UP     &trans     &trans  &kp M            &trans  &trans  &trans  &trans  &trans  &trans
     &trans  &kp LEFT   &kp DOWN   &kp RIGHT  &trans  &kp SPACE        &trans  &trans  &trans  &trans  &trans  &trans
     &trans  &trans     &trans     &trans     &trans  &trans           &trans  &trans  &trans  &trans  &trans  &trans
                                   &trans     &trans  &trans           &trans  &trans  &trans
                        >;
                };


                lower_layer {
// .----------------------------------------------------------.        .-----------------------------------------------------.
// |    TAB    |   !    |   @    |   #    |    $    |    %     |       |    ^   |    &   |    *    |    (   |    )   |  DEL  |
// |-----------+--------+--------+--------+---------+----------|       |--------+--------+---------+--------+--------+-------|
// |   SHFT    |    ~   |    *   |   +    |         |     =    |       |  left  |  down  |    up   |  right |   pu   |  pd   |
// |-----------+--------+--------+--------+---------+----------|       |--------+--------+---------+--------+--------+-------|
// |   CTRL    |    |   |    /   |   -    |         |  insert  |       |  home  |  end   |    ,    |    .   |    ?   |   \   |
// '-----------------------------+--------+---------+----------+       |--------+--------+---------+-------------------------'
//                               |  ALT   |         |ADJ_ENTER |       |   RET  |  CTRL  |  SHIFT  |
//                               '--------+---------+----------'       '--------+--------+---------'

                        bindings = <
   &kp TAB     &kp EXCLAMATION   &kp AT            &kp HASH     &kp DOLLAR  &kp PERCENT        &kp CARET   &kp AMPS     &kp STAR     &kp LPAR    &kp RPAR       &kp DEL
   &kp LSHFT   &kp GRAVE         &kp KP_MULTIPLY   &kp KP_PLUS  &trans      &kp KP_EQUAL       &kp LEFT    &kp DOWN     &kp UP       &kp RIGHT   &kp PG_UP      &kp PG_DN
   &kp LCTRL   &kp PIPE          &kp KP_DIVIDE     &kp MINUS    &trans      &kp INSERT         &kp HOME    &kp END      &kp COMMA    &kp PERIOD  &kp QUESTION   &kp BSLH
                                                   &kp LALT     &trans      &lt_f18 ADJ ENTER      &kp ENTER   &kp RCTRL    &kp RSHIFT
                        >;
                };


                  raise_layer {
// .------------------------------------------------------.       .-----------------------------------------------------.
// |   TAB   |    *   |    1   |    2   |    3   |    -   |       | vol up |   F1   |   F2   |   F3   |   F4   |   DEL  |
// |---------+--------+--------+--------+--------+--------|       |--------+--------+--------+--------+--------+--------|
// |   SHFT  |    /   |    4   |    5   |    6   |    +   |       | vol dn |   F5   |   F6   |   F7   |   F8   |    ~   |
// |---------+--------+--------+--------+--------+--------|       |--------+--------+--------+--------+--------+--------|
// |   CTRL  |    =   |    7   |    8   |    9   |    .   |       |  next  |   F9   |   F10  |   F11  |   F12  |    \   |
// '---------------------------+--------+--------+--------+       |-------+---------+--------+--------------------------'
//                             |    0   |   ADJ  |        |       |        |        |        |
//                             '--------+--------+--------'       '--------+--------+--------'
                        bindings = <
   &kp TAB    &kp KP_ASTERISK &kp N1 &kp N2 &kp N3 &kp MINUS           &kp C_VOL_UP &kp F1  &kp F2  &kp F3  &kp F4  &kp DEL
   &kp LSHFT  &kp KP_SLASH    &kp N4 &kp N5 &kp N6 &kp KP_PLUS         &kp C_VOL_DN &kp F5  &kp F6  &kp F7  &kp F8  &kp GRAVE
   &kp LCTRL  &kp EQUAL       &kp N7 &kp N8 &kp N9 &kp KP_DOT          &kp C_NEXT &kp F9  &kp F10 &kp F11 &kp F12 &kp BSLH
                              &kp N0        &mo_f19 ADJ   &trans           &trans &trans  &trans
                        >;
                };


                adjust_layer {
// .--------------------------------------------------------.       .------------------------------------------------------.
// |  reset  |        |        |        |         |  KP_NUM |       |  DEF   |  GAME  |        |        |        |  reset  |
// |---------+--------+--------+--------+---------+---------|       |--------+--------+--------+--------+--------+---------|
// |         |  BT1   |  BT2   |  BT3   |  BT4    |  BT5    |       |  BT5   |  BT4   |  BT3   |  BT2   |  BT1   |         |
// |---------+--------+--------+--------+---------+---------|       |--------+--------+--------+--------+--------+---------|
// |  BTCLR  |        |        |        |         |         |       |        |        |        |        |        |  BTCLR  |
// '---------------------------+--------+---------+---------+       |--------+--------+--------+---------------------------'
//                             |        |         |         |       |        |        |        |
//                             '--------+---------+---------'       '--------+--------+--------'

                        bindings = <
   &sys_reset      &trans        &trans        &trans        &trans          &kp KP_NUM            &tog DEF      &tog GAME        &trans        &trans        &trans        &sys_reset
   &sys_reset      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4      &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans
   &bt BT_CLR  &trans        &trans        &trans        &trans          &trans            &trans        &trans        &trans        &trans        &trans        &bt BT_CLR
                             &trans        &trans        &trans                            &trans        &trans        &trans
                        >;
                };

                opt_layer {
// Active while thumb Opt is held. Everything falls through except V = toggle WASD.
                        bindings = <
     &trans  &trans  &trans  &trans  &trans    &trans          &trans  &trans  &trans  &trans  &trans  &trans
     &trans  &trans  &trans  &trans  &trans    &trans          &trans  &trans  &trans  &trans  &trans  &trans
     &trans  &trans  &trans  &trans  &tog WASD &trans          &trans  &trans  &trans  &trans  &trans  &trans
                             &trans  &trans    &trans          &trans  &trans  &trans
                        >;
                };
         };
};
